# Copy to .env.local and fill locally. Never commit real values.
DATABASE_URL=
NASA_RSS_URL=https://www.nasa.gov/news-release/feed
NASA_NEWS_ARCHIVE_URL=https://www.nasa.gov/news-release/
BACKFILL_DAYS=180
RETENTION_DAYS=180

# Required when creating the Checkpoint 3 Pinecone index. Keep these server-side.
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=nasa-news

# Optional LangSmith workflow tracing. Leave disabled unless you want traces.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=the-orbit-brief
# INGESTION_SECRET=
